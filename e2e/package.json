{
  "name": "@expenses/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright smoke tests that boot the built API and web app against a dedicated PostgreSQL database",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "eslint \"**/*.ts\" && tsc --noEmit",
    "clean": "rimraf test-results playwright-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "dotenv": "17.4.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "rimraf": "6.1.4",
    "typescript": "6.0.3"
  }
}
