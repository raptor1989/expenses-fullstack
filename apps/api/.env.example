# API Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expenses_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7D

# Cors Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Password reset e-mail (SMTP)
# Leave SMTP_HOST empty to log the reset link to the console and logs/password-resets.log instead.
# SMTP_PORT 587 uses STARTTLS, 465 uses TLS. MAIL_FROM defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Reverse proxy
# Set to true when the API runs behind nginx/Caddy so rate limiting sees the real client IP
TRUST_PROXY=false
