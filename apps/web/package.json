{
  "name": "@expenses/web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "React frontend for the household expenses management app",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "format": "prettier --config ./.prettierrc --write \"**/*.{ts,tsx}\"",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "serve:dist": "sirv dist --single --host 0.0.0.0 --port 5173",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@expenses/shared": "*",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-date-pickers": "9.17.0",
    "@nivo/bar": "0.99.0",
    "@nivo/core": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/pie": "0.99.0",
    "axios": "1.21.0",
    "dayjs": "1.11.23",
    "formik": "2.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "sirv-cli": "3.0.1",
    "yup": "1.7.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
